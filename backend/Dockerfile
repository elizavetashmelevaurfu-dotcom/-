# =====================================================================
# ЭТАП 1: Сборка приложения (Build Stage)
# =====================================================================
# Берем образ с установленным Maven и JDK 23 (чтобы совпадало с вашей локальной версией Java)
FROM maven:3.9-eclipse-temurin-23 AS build

# Задаем рабочую директорию внутри контейнера
WORKDIR /app

# Шаг 1: Копируем ТОЛЬКО pom.xml
# Это делается для оптимизации кэша Docker. 
# Если вы поменяете код в Java-файлах, Docker не будет заново скачивать все зависимости из интернета.
COPY pom.xml .

# Шаг 2: Скачиваем зависимости
# Флаг -B (batch mode) отключает интерактивный режим
RUN mvn dependency:go-offline -B

# Шаг 3: Копируем весь исходный код (папку src) внутрь контейнера
# Здесь как раз попадет ваш код из src/main/java/urfu/backend/...
COPY src ./src

# Шаг 4: Собираем проект
# Флаг -DskipTests пропускает тесты, чтобы ускорить сборку (тесты лучше гонять в CI/CD, а не при сборке образа)
RUN mvn clean package -DskipTests


# =====================================================================
# ЭТАП 2: Запуск приложения (Runtime Stage)
# =====================================================================
# Берем легковесный образ (Alpine Linux), содержащий только JRE (без компилятора и Maven)
# Это сильно уменьшит итоговый размер Docker-образа (с ~500MB до ~200MB)
FROM eclipse-temurin:23-jre-alpine

# Задаем рабочую директорию
WORKDIR /app

# Создаем непривилегированного пользователя (Best Practice по безопасности)
# Запускать приложение от имени root (по умолчанию) — плохая идея.
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# Копируем собранный JAR-файл из первого этапа (build) в текущую папку
# Звездочка *.jar нужна, потому что имя файла содержит версию (например, backend-0.0.1-SNAPSHOT.jar)
COPY --from=build /app/target/*.jar app.jar

# Указываем, какой порт слушает приложение (информативно для Docker)
EXPOSE 8080

# Команда, которая выполнится при старте контейнера
ENTRYPOINT ["java", "-jar", "app.jar"]